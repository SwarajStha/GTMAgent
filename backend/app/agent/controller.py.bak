"""Agent Controller — Claude tool-use orchestrator.

Exposes the ingestion, matching, and generation modules as Claude
tools and lets the model drive multi-step workflows ("find me top 5
matches for tender X and draft outreach for the best one").
"""
from __future__ import annotations

import json
from typing import Any
import anthropic
from app.db.session import SessionLocal
from app.db.models import AgentRun
from app.agent.tools import AGENT_TOOLS, dispatch_tool

SYSTEM_PROMPT = """You are the GTM Agent Orchestrator. 
Your goal is to fulfill user requests related to public procurement matching by executing a sequence of tool calls.
1. Formulate a plan.
2. Execute proper tools.
3. Review the outputs.
4. Summarise the results back to the user.
Always use tool calls to interact with data. Think step-by-step before invoking multiple tools.
"""

class AgentController:
    """Top-level orchestrator that turns user goals into tool calls."""

    def __init__(self, model: str = "claude-3-5-sonnet-20241022", api_key: str | None = None) -> None:
        self.model = model
        self.client = anthropic.Anthropic(api_key=api_key)

    def run(self, user_goal: str) -> dict[str, Any]:
        """Runs the planner-executor tool loop for a given user goal."""
        messages = [
            {"role": "user", "content": user_goal}
        ]
        
        steps_taken = []
        final_output = ""

        # Main tool-use loop
        with SessionLocal() as db_session:
            while True:
                response = self.client.messages.create(
                    model=self.model,
                    max_tokens=2048,
                    system=[
                        {
                            "type": "text", 
                            "text": SYSTEM_PROMPT,
                            "cache_control": {"type": "ephemeral"}
                        }
                    ],
                    messages=messages,
                    tools=AGENT_TOOLS
                )

                if response.stop_reason == "tool_use":
                    # Assistant wants to call a tool
                    # Append assistant's message
                    messages.append({"role": "assistant", "content": response.content})
                    
                    for block in response.content:
                        if block.type == "tool_use":
                            tool_name = block.name
                            tool_args = block.input
                            
                            steps_taken.append({"tool": tool_name, "args": tool_args})
                            
                            # Dispatch to our internal functions
                            tool_result = dispatch_tool(tool_name, tool_args, db_session)
                            
                            # Append tool result
                            messages.append({
                                "role": "user",
                                "content": [
                                    {
                                        "type": "tool_result",
                                        "tool_use_id": block.id,
                                        "content": tool_result
                                    }
                                ]
                            })
                else:
                    # Agent is done
                    final_output = response.content[0].text
                    break
            
            # Save the run to db
            run_record = AgentRun(
                goal=user_goal,
                steps=steps_taken,
                output=final_output
            )
            db_session.add(run_record)
            db_session.commit()
            
        return {
            "goal": user_goal,
            "steps": steps_taken,
            "output": final_output
        }
