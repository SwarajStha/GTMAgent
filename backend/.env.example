# ─────────────────────────────────────────────────────────────────────────────
# GTMAgent — backend environment template
#
# Copy this file to `backend/.env` and fill in the secrets:
#     cp backend/.env.example backend/.env
#
# Every key below has a working default in app/core/config.py, so the ONLY value
# you must set for full functionality is ANTHROPIC_API_KEY (needed for the LLM
# features — agent, email drafter, tender extraction, reflection narrative).
# Without it those features fall back to deterministic, non-LLM output.
# Never commit your filled-in .env — it is gitignored on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Two URLs, two ports, one database (see README "Connection strings"):
#   * DATABASE_URL         → pooled alias (6543), used by the FastAPI app.
#   * DATABASE_URL_DIRECT  → direct (5432),  used by Alembic migrations.
# Inside docker-compose both collapse to db:5432 (compose overrides them there),
# so these localhost values are for running the app on the host.
DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:6543/gtm
DATABASE_URL_DIRECT=postgresql+psycopg://gtm:gtm@localhost:5432/gtm

# Separate database used ONLY by the pytest suite — it TRUNCATEs/CREATEs/DROPs
# freely, so it must NOT point at your dev DB. One-time setup (create the DB +
# `vector` extension) is in backend/scripts/README.md.
DATABASE_URL_TEST=postgresql+psycopg://gtm:gtm@localhost:5432/gtm_test

# ── LLM (Anthropic / Claude) ─────────────────────────────────────────────────
# Required for the agent, email drafter, tender extraction, and reflection
# narrative. Get a key at https://console.anthropic.com/. Leave empty to run
# with deterministic fallbacks (no paid Claude calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional web-search key (not required for the core pipeline).
TAVILY_API_KEY=

# ── Ingestion / app behaviour ────────────────────────────────────────────────
# Comma-separated CPV prefixes to pull from TED (construction, IT, energy).
ALLOWED_CPV_CODES=45000000-7,72000000-5,09330000-1
LOG_LEVEL=INFO
ENVIRONMENT=development
# Browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
# Where downloaded tender-dossier PDFs are written.
DOSSIER_STORAGE_PATH=./storage/dossiers

# ── Optional knobs (sensible defaults in config.py — leave unset unless tuning) ─
# In-process ingestion/reflection scheduler is OPT-IN so a normal boot never
# starts polling live TED. Set to true only in a real deployment.
SCHEDULER_ENABLED=false
# Per-IP rate limiting on the paid LLM endpoints (denial-of-wallet guard).
RATE_LIMIT_ENABLED=true
# Optional least-privilege, read-only connection for the agent's query_db tool.
# When empty, query_db runs on the guarded shared session instead. Provision the
# role with backend/scripts/create_readonly_role.sql.
DATABASE_URL_READONLY=
